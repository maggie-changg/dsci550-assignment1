import datefinder
from datetime import datetime


haunted_places = pd.read_csv("../data/haunted_places.tsv", sep='\t')
def get_date(description):
    dates = list(datefinder.find_dates(description))
    if len(dates) >= 1:
        return dates[0].strftime("%Y/%m/%d")
    else:
        return "2025/01/01"

haunted_places["Haunted Places Date"] = haunted_places["description"].apply(get_date)
